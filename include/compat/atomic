#pragma once

namespace std {
    enum memory_order {
        memory_order_relaxed,
        memory_order_consume,
        memory_order_acquire,
        memory_order_release,
        memory_order_acq_rel,
        memory_order_seq_cst
    };
    
    template<typename T>
    class atomic {
        volatile T value_;
        
    public:
        atomic() : value_() {}
        atomic(T desired) : value_(desired) {}
        
        T load(memory_order = memory_order_seq_cst) const volatile {
            return value_;
        }
        
        void store(T desired, memory_order = memory_order_seq_cst) volatile {
            value_ = desired;
        }
        
        T fetch_add(T arg, memory_order = memory_order_seq_cst) volatile {
            T old = value_;
            value_ += arg;
            return old;
        }
        
        T fetch_sub(T arg, memory_order = memory_order_seq_cst) volatile {
            T old = value_;
            value_ -= arg;
            return old;
        }
        
        operator T() const volatile { return load(); }
        T operator=(T desired) volatile { store(desired); return desired; }
    };
}